# Build the static replay viewer with the same pinned Nim sources as the
# native game. The output is architecture-neutral WebAssembly even though this
# reproducible toolchain container runs as linux/amd64.
#
# Inherited verbatim from coworld-ctf's Dockerfile.replay-viewer (pinned
# emscripten/emsdk:4.0.15, pinned nimby 0.1.27 with its sha256 check,
# nimby use 2.2.4, the marker sed splices and the whole test -f / grep -q
# assertion block) with three named edits: the WORKDIR is /workspace/snake;
# the league.html splice and its four assertions are DELETED with
# client/league_replayer.html; and the asset list is the snake kit.
FROM emscripten/emsdk:4.0.15 AS replay-viewer-builder

RUN apt-get update && \
  apt-get install -y --no-install-recommends ca-certificates curl git && \
  rm -rf /var/lib/apt/lists/* && \
  curl -fsSL \
    -o /usr/local/bin/nimby \
    https://github.com/treeform/nimby/releases/download/0.1.27/nimby-Linux-X64 && \
  echo "3b3084394bd26b09f84a3f82389f075221c8784893238390939d71dd66ac9e8b  /usr/local/bin/nimby" | sha256sum -c - && \
  chmod +x /usr/local/bin/nimby && \
  nimby use 2.2.4

ENV PATH="/root/.nimby/nim/bin:$PATH"

WORKDIR /workspace/snake
COPY nimby.lock .
RUN nimby --global sync nimby.lock

COPY . .
RUN nim c -d:emscripten replay-viewer/snake_replay.nim && \
  nim c -r --hints:off -o:/tmp/gen_wire_constants tools/gen_wire_constants.nim \
    > replay-viewer/dist/wire_constants.js && \
  cp client/broadcast_core.js replay-viewer/dist/broadcast_core.js && \
  cp client/chrome_common.js replay-viewer/dist/chrome_common.js && \
  cp data/font.ttf replay-viewer/dist/font.ttf && \
  cp replay-viewer/static_replay.js replay-viewer/dist/static_replay.js && \
  cp replay-viewer/static_replay_worker.js replay-viewer/dist/static_replay_worker.js && \
  sed -e 's|<!-- WIRE_CONSTANTS -->|<script src="./wire_constants.js"></script>|' \
      -e 's|<!-- CHROME_COMMON -->|<script src="./chrome_common.js"></script>|' \
      -e 's|<!-- BROADCAST_CORE -->|<script src="./static_replay.js"></script>|' \
    client/replay_broadcast.html > replay-viewer/dist/index.html && \
  cp data/snake_amber_head_u.png data/snake_amber_head_r.png \
    data/snake_amber_head_d.png data/snake_amber_head_l.png \
    data/snake_amber_body.png data/snake_amber_corner.png \
    data/snake_amber_tail.png \
    data/snake_teal_head_u.png data/snake_teal_head_r.png \
    data/snake_teal_head_d.png data/snake_teal_head_l.png \
    data/snake_teal_body.png data/snake_teal_corner.png \
    data/snake_teal_tail.png \
    data/snake_violet_head_u.png data/snake_violet_head_r.png \
    data/snake_violet_head_d.png data/snake_violet_head_l.png \
    data/snake_violet_body.png data/snake_violet_corner.png \
    data/snake_violet_tail.png \
    data/snake_lime_head_u.png data/snake_lime_head_r.png \
    data/snake_lime_head_d.png data/snake_lime_head_l.png \
    data/snake_lime_body.png data/snake_lime_corner.png \
    data/snake_lime_tail.png \
    data/food_apple.png data/wreck.png \
    data/arena_floor.png data/ascii.png data/pallete.png \
    replay-viewer/dist/ && \
  mkdir -p replay-viewer/dist/art/walls replay-viewer/dist/art/lockerroom && \
  cp client/art/walls/wall_h.jpg client/art/walls/wall_v.jpg \
    replay-viewer/dist/art/walls/ && \
  cp client/art/lockerroom/bg.jpg client/art/lockerroom/*.webp \
    replay-viewer/dist/art/lockerroom/ && \
  rm -rf replay-viewer/dist/nimcache && \
  test -f replay-viewer/dist/snake_replay.wasm && \
  test -f replay-viewer/dist/snake_replay.data && \
  test -f replay-viewer/dist/static_replay_worker.js && \
  test -f replay-viewer/dist/index.html && \
  test -s replay-viewer/dist/wire_constants.js && \
  grep -q '^window.SNAKE_WIRE={' replay-viewer/dist/wire_constants.js && \
  grep -q 'wire_constants.js' replay-viewer/dist/index.html && \
  test -s replay-viewer/dist/chrome_common.js && \
  grep -q 'window.ChromeCommon' replay-viewer/dist/chrome_common.js && \
  grep -q 'chrome_common.js' replay-viewer/dist/index.html && \
  grep -q 'static_replay_worker.js' replay-viewer/dist/static_replay.js && \
  ! grep -q '<script src="./broadcast_core.js"></script>' replay-viewer/dist/index.html && \
  ! grep -q '<script src="./snake_replay.js"></script>' replay-viewer/dist/index.html && \
  test -f replay-viewer/dist/snake_amber_head_u.png && \
  test -f replay-viewer/dist/snake_teal_body.png && \
  test -f replay-viewer/dist/snake_violet_corner.png && \
  test -f replay-viewer/dist/snake_lime_tail.png && \
  test -f replay-viewer/dist/food_apple.png && \
  test -f replay-viewer/dist/wreck.png && \
  test -f replay-viewer/dist/art/walls/wall_h.jpg && \
  test -f replay-viewer/dist/art/lockerroom/bg.jpg && \
  test -f replay-viewer/dist/art/lockerroom/green_1.webp && \
  test -f replay-viewer/dist/art/lockerroom/red_6.webp
